# Multica → Telegram 通知适配器配置模板（SEE-1561）
# 复制到 ~/.config/dev-forge/see-1561.env 并填写，权限设为 600：
#   mkdir -p ~/.config/dev-forge && cp config.example.env ~/.config/dev-forge/see-1561.env
#   chmod 600 ~/.config/dev-forge/see-1561.env
# 不要把真实凭据提交到仓库或发到 issue/评论。

# Multica Personal Access Token（mul_ 前缀，在 Multica 设置中创建）
NOTIFIER_MULTICA_PAT=<你的 PAT>

# BotFather 创建 bot 后下发的 token（形如「数字:字母数字串」）
NOTIFIER_TELEGRAM_BOT_TOKEN=<你的 bot token>

# Owner 的数字 chat ID（正整数）：唯一投递目标，其他私聊一律不受理
NOTIFIER_TELEGRAM_CHAT_ID=<你的数字 chat ID>

# Multica 部署根地址（http/https）
NOTIFIER_MULTICA_SERVER_URL=http://multica.example.internal:9278

# 只转发该 workspace 的 inbox:new
NOTIFIER_WORKSPACE_ID=<workspace UUID>

# —— 可选项（不设则用默认值）——
# Telegram Bot API 根地址（自建代理/测试伪服务器时才需要改）
# NOTIFIER_TELEGRAM_API_BASE=https://api.telegram.org
# 去重状态文件
# NOTIFIER_STATE_FILE=~/.local/state/dev-forge/multica-telegram-notifier/state.json
# 断线重连退避秒数序列
# NOTIFIER_RECONNECT_BACKOFF=1,2,4,8,15,30
# sendMessage 失败重试间隔秒数
# NOTIFIER_SEND_RETRIES=1,2,4
# 连接/HTTP 超时秒数
# NOTIFIER_CONNECT_TIMEOUT=10
# 单帧读取超时秒数（须大于服务端 ~54s ping 周期）
# NOTIFIER_READ_TIMEOUT=90
# 元信息只读查询（Agent 显示名/issue 标识符）根地址，默认同 NOTIFIER_MULTICA_SERVER_URL
# NOTIFIER_API_BASE=http://multica.example.internal:9278
# 单次元信息查询超时秒数（查询失败自动降级，不阻断通知投递）
# NOTIFIER_QUERY_TIMEOUT=5
