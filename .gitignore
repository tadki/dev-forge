claude-hooks/unified/state/
__pycache__/
*.pyc
node_modules/

# grepai: project config is tracked; runtime artifacts (locks, gob caches, logs) are not
# config.yaml 会被 grepai watch 持续改写 watch.last_index_time。本机对其设了
# `git update-index --skip-worktree .grepai/config.yaml` 屏蔽该噪声；
# 真实改配置时先 `--no-skip-worktree` 解除、改完提交后再设回。
.grepai/*
!.grepai/config.yaml

# forge-console (console/): 构建产物与运行态
console/**/dist/
console/**/node_modules/
*.tsbuildinfo
console/registry.snapshot.json
console/state/
console/e2e/test-results/
console/e2e/playwright-report/

# claude 本地运行态（hook-fire 日志、push-guard 审计、settings.local.json）
.claude/

# SEE-1561 notifier live-probe 运行产物（正常应写仓库外路径，此处兜底防误提交）
live-probe*.jsonl
