[Unit]
Description=forge-console · dev-forge harness 监控台（只读采集 + Web UI）
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/tools/dev-forge/console
EnvironmentFile=%h/.config/forge-console/env
ExecStart=/usr/bin/node %h/tools/dev-forge/console/packages/server/dist/index.js
# on-failure 不救 TERM 干净退出（被误杀即失联）——故用 always；行尾注释会让 systemd 解析失败，注释必须独立成行
Restart=always
RestartSec=3

# 安全收敛：只读采集 + 平台对账写操作所需的最小权限
NoNewPrivileges=true
# PrivateTmp 必须关闭：repo-sync 判活要读宿主 /tmp 的 pid 文件
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
# 允许读：~/.claude、dev-forge、~/.multica、~/.hindsight、/mnt/d、/mnt/c 桥文件
# 写：平台对账（逐次 confirm 后执行）——registry.d 声明回写 + 已登记资产文件的本地/平台同步。
# file-write 目标受服务端白名单约束（只允许当前采集到的资产路径），这里按需放行其根目录。
ReadWritePaths=%h/tools/dev-forge
ReadWritePaths=%h/tools/grepai
ReadWritePaths=%h/tools/godot-qa-toolkit
ReadWritePaths=%h/.claude
ReadWritePaths=%h/multica_workspaces
ReadWritePaths=/mnt/d/GodotProjects
StateDirectory=forge-console
LogsDirectory=forge-console

[Install]
WantedBy=default.target
