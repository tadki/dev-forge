  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/generate-json-schema.js",
    "test": "vitest run --reporter=basic"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.5"
  }
}
