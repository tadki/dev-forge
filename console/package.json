{
  "name": "forge-console",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter web build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @forge/e2e test",
    "dev:server": "pnpm --filter @forge/server dev",
    "dev:web": "pnpm --filter web dev",
    "start": "pnpm --filter @forge/server start",
    "collect": "pnpm --filter @forge/collectors collect"
  }
}
